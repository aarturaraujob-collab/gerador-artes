<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /urano/

  # Let Apache serve files and directories normally.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route every application URL back to the React entry point.
  RewriteRule ^ index.html [L]
</IfModule>
